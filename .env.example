# Shared
NODE_ENV=development

# Web
API_URL=http://localhost:4100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
# Deprecated browser-visible fallback; use API_URL for new deployments.
NEXT_PUBLIC_API_URL=http://localhost:4100

# Firebase web configuration is public by design, but keep development and
# production values separate. These placeholders are safe for the local emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-harambeeone.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-harambeeone
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-harambeeone.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_VAPID_KEY=demo-vapid-public-key
FCM_DELIVERY_ENABLED=false
FCM_DELIVERY_INTERVAL_SECONDS=30

# Stellar testnet demonstration only. Testnet XLM has no monetary value.
STELLAR_DEMO_UGX_PER_XLM=1000
STELLAR_DEMO_FAUCET_ENABLED=false
STELLAR_DEMO_HOURLY_LIMIT=12
# Local emulator only; leave both emulator host variables unset outside development.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

# Python API
PORT=4100
# Copy the Session pooler URI from Supabase Connect and URL-encode the password.
DATABASE_PROVIDER=url
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# For the Firebase SQL runtime, set DATABASE_PROVIDER=cloud_sql and use an attached
# least-privilege IAM identity with ADC. No database password is used.
CLOUD_SQL_INSTANCE=PROJECT_ID:REGION:INSTANCE
CLOUD_SQL_DATABASE=harambeeone
CLOUD_SQL_USER=service-account@PROJECT_ID.iam
CLOUD_SQL_SERVER_ROLE=firebasewriter_harambeeone_public
# F3 rehearsal/cutover tools read these server-only URLs; never expose them as NEXT_PUBLIC values.
SOURCE_DATABASE_URL=postgresql+psycopg://SOURCE_USER:PASSWORD@SOURCE_HOST:5432/postgres?sslmode=require
TARGET_DATABASE_URL=postgresql+psycopg://TARGET_USER:PASSWORD@TARGET_HOST:5432/harambeeone?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Required only for the temporary AUTH_PROVIDER=supabase rollback boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only Firebase Admin configuration. Prefer an attached least-privilege
# service account in Google Cloud. For local non-emulator work, point ADC to a
# credential file stored outside this repository; never commit the JSON file.
FIREBASE_PROJECT_ID=demo-harambeeone
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
AUTH_PROVIDER=firebase
# Server-side Google AI Studio auth key. Never expose it in NEXT_PUBLIC_*.
GEMINI_API_KEY=
# Free-tier model reviewed for the privacy-safe assistant workflows.
GEMINI_MODEL=gemini-3.1-flash-lite
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=replace-me-in-production

# Messaging / language integrations (optional)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
SUNBIRD_API_KEY=

# Stellar / settlement integrations (optional until enabled)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_DISTRIBUTION_ACCOUNT=
SDP_BASE_URL=
SDP_API_KEY=
ONRAMP_PROVIDER=
OFFRAMP_PROVIDER=
