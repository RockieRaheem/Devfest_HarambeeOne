# Shared
NODE_ENV=development

# Web
API_URL=http://localhost:4100
# Deprecated browser-visible fallback; use API_URL for new deployments.
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Python API
PORT=4100
# Copy the Session pooler URI from Supabase Connect and URL-encode the password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Server-side Google AI Studio auth key. Never expose it in NEXT_PUBLIC_*.
GEMINI_API_KEY=
# The application intentionally accepts only this reviewed Gemma model.
GEMMA_MODEL=gemma-4-26b-a4b-it
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=replace-me-in-production

# Messaging / language integrations (optional)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
SUNBIRD_API_KEY=

# Stellar / settlement integrations (optional until enabled)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_DISTRIBUTION_ACCOUNT=
SDP_BASE_URL=
SDP_API_KEY=
ONRAMP_PROVIDER=
OFFRAMP_PROVIDER=
