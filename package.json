{
  "name": "harambeeone",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @harambeeone/web --filter @harambeeone/backend dev",
    "dev:web": "pnpm --filter @harambeeone/web dev",
    "dev:api": "pnpm --filter @harambeeone/backend dev",
    "build": "pnpm --filter @harambeeone/backend --filter @harambeeone/web build",
    "build:legacy": "pnpm --filter @harambeeone/api build",
    "lint": "pnpm --filter @harambeeone/backend --filter @harambeeone/web lint",
    "typecheck": "pnpm --filter @harambeeone/web exec tsc --noEmit",
    "firebase:env:check": "node scripts/validate-firebase-env.mjs",
    "firebase:env:check:emulator": "node scripts/validate-firebase-env.mjs --emulator",
    "firebase:emulators": "firebase emulators:start --project demo-harambeeone --config firebase.json --only auth,dataconnect",
    "firebase:emulators:verify": "firebase emulators:exec --project demo-harambeeone --config firebase.json --only auth,dataconnect \"node scripts/verify-firebase-emulators.mjs\"",
    "firebase:auth:verify": "firebase emulators:exec --project demo-harambeeone --config firebase.json --only auth \"node scripts/verify-firebase-auth-flows.mjs\"",
    "firebase:sql:schema": "node scripts/apply-cloudsql-schema.mjs",
    "firebase:sql:data": "node scripts/migrate-cloudsql-data.mjs",
    "firebase:sql:revoke-owner": "node scripts/revoke-cloudsql-owner.mjs",
    "firebase:sql:verify": "node scripts/verify-cloudsql-controls.mjs",
    "firebase:sql:runtime": "pnpm --filter @harambeeone/backend exec uv run --no-sync python scripts/verify_cloudsql_runtime.py",
    "auth:migrate": "pnpm --filter @harambeeone/backend auth:migrate --",
    "db:revision": "pnpm --filter @harambeeone/backend db:revision",
    "db:migrate": "pnpm --filter @harambeeone/backend db:migrate",
    "db:seed": "pnpm --filter @harambeeone/backend db:seed"
  },
  "devDependencies": {
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1"
  }
}
